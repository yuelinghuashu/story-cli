{
  "name": "@yuelinghuashu/story-cli",
  "version": "1.5.0",
  "packageManager": "pnpm@11.21.0",
  "description": "A zero-deploy, Git-native content management CLI for Markdown stories. Manage stories with directory conventions, generate READMEs, export epub.",
  "type": "module",
  "bin": {
    "story": "./dist/bin/index.js"
  },
  "main": "./dist/src/cli.js",
  "files": [
    "dist/",
    "templates/"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node -e \"try{require('fs').chmodSync('dist/bin/index.js',0o755)}catch(e){}\"",
    "test": "node --test tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"bench/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=70 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/ bin/ bench/ scripts/",
    "lint:fix": "biome check --write src/ tests/ bin/ bench/ scripts/",
    "format": "biome format --write src/ tests/ bin/ bench/ scripts/",
    "check:docs": "node scripts/sync-docs.ts",
    "bench": "node bench/generate.ts && node bench/bench.ts",
    "bench:generate": "node bench/generate.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm lint && pnpm build"
  },
  "keywords": [
    "story",
    "novel",
    "fiction",
    "writing",
    "markdown",
    "cms",
    "cli",
    "git",
    "epub",
    "mcp",
    "ai",
    "llm"
  ],
  "author": "yuelinghuashu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuelinghuashu/story-cli.git"
  },
  "homepage": "https://github.com/yuelinghuashu/story-cli#readme",
  "bugs": {
    "url": "https://github.com/yuelinghuashu/story-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
